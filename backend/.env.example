# ===========================================
# Workspace Backend - Environment Variables
# ===========================================

# -------------------------------------------
# Required Variables
# -------------------------------------------

# PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/workspace?schema=public"

# JWT secret for access tokens (min 32 characters)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# JWT secret for refresh tokens (min 32 characters)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-chars"

# -------------------------------------------
# Optional Variables (with defaults)
# -------------------------------------------

# Application environment: development | production | test
NODE_ENV="development"

# Server port
PORT=3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Rate limit for auth routes (requests per minute per IP)
RATE_LIMIT_AUTH=10

# Rate limit for API routes (requests per minute per user)
RATE_LIMIT_API=100

# Maximum upload file size in MB
UPLOAD_MAX_SIZE_MB=10

# Directory for file uploads
UPLOAD_DIR="./uploads"
